# Copy to .env and adjust. Matches docker-compose.yml defaults.
# Leave the Cloud SQL variables unset for local Postgres or the Cloud SQL Auth Proxy.
DATABASE_URL=postgresql://weather:weather@localhost:5432/weather

# Cloud Run only. Requires --add-cloudsql-instances on the service and the job.
# CLOUD_SQL_CONNECTION_NAME=your-project:europe-west1:city-weather-pg
# DB_USER=weather
# DB_PASSWORD=
# DB_NAME=weather

# Optional overrides
# BACKFILL_START_DATE=2024-01-01
# ARCHIVE_LAG_DAYS=5
# INCREMENTAL_OVERLAP_DAYS=3
# HTTP_MAX_RETRIES=4
